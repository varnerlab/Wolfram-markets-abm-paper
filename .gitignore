# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest*.toml
# The corrected study is an application snapshot with a frozen environment.
!output/rebuilt/manuscript-reserve-v1/code/Manifest.toml

# File generated by the Preferences package to store local preferences
LocalPreferences.toml
JuliaLocalPreferences.toml

# Simulation data — too large for git
code/data/*.jld2
!code/data/ModelB-StripFrames.jld2
!code/data/ModelA-FiniteSizeStrips.jld2
code/data/*.csv
!code/data/ModelB-Stage2-*.csv
!code/data/ModelB-Nucleation-*.csv
!code/data/ModelB-ReturnDiagnostics-Summary.csv
!code/data/ModelA-FiniteSize*.csv
!code/data/ModelA-Avrami*.csv
!code/data/ModelA-OnsetTime*.csv
!code/data/ModelB-ReservoirQuench-Full-*.csv
!code/data/ModelB-FiniteSizeQuench-Full-*.csv
!code/data/ModelB-BalanceSheetQuench-Full-*.csv
code/data/*-Checkpoints/
tmp/pdfs/

# Model A boundary forcing: retained as an archival copy of a defunct vendor's
# output (oneminutedata.com), since the series cannot be re-obtained. Provenance
# and checksum are recorded in code/data/README.md.
!code/data/QQQ-OHLC-1-min-aggregate-2024.csv

# LaTeX build-state files (the refreshed PDF and bibliography remain tracked)
paper-arxiv/*.fdb_latexmk
paper-arxiv/*.fls

# Seed-level artifacts required by the arXiv paper and revision controls.
!code/data/ModelB-RuleQuench-Full-*.csv
!code/data/ModelB-RuleQuench-Full-Exemplar.jld2
!code/data/ModelB-Revision-*.csv

# Following experiments: deposited summaries and protocol manifests.
!code/data/Following-*.csv
# The historical diagnostic exceeds GitHub's per-file limit. Its lossless
# .csv.gz archive and checksum record are versioned instead.
/code/data/Following-Diagnostic-confirmation-Summary.csv
code/data/Following-*-Checkpoints/

# Python analysis bytecode.
__pycache__/

# Transient output from the isolated arXiv compilation check.
output/arxiv/clean-build.log

# Repaired campaigns retain compact summaries and manifests in version control.
output/repaired/*/checkpoints/
output/rebuilt/*/code/data/*Checkpoints/
output/repaired/*-failed-threading/
