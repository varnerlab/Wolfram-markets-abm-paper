\begin{figure}[tb]
  \centering
  \includegraphics[width=0.95\linewidth]{figs/Fig1-RuleQuench.pdf}
  \caption{A paired rule quench separated initially identical markets. Fifty
  seeds were run on a $64\times64$ lattice for 1,000 baseline steps and 3,000
  post-activation steps. The dormant arm retained the same target sites but
  did not switch their rules. \textbf{(A)}~Median price divided by its value at
  activation; bands mark the interquartile range. \textbf{(B)}~Median interior
  Sell fraction; the horizontal line marks the majority threshold.
  \textbf{(C)}~Time-sliced lattices for seed 12, the $f=0.20$ pair nearest the
  median treated-control peak-Sell difference. Blue, gray, and orange cells denote
  Buy, Hold, and Sell. The two rows show the dormant and treated arms from
  their common activation state through 3,000 steps. All paired paths coincide
  before the vertical activation line.}
  \label{fig:rule-quench}
\end{figure}
\efloatseparator
 
\begin{figure}[tb]
  \centering
  \includegraphics[width=0.97\linewidth]{figs/Fig2-ReservoirQuench.pdf}
  \caption{Rule activation across explicit dealer capacities.
  \textbf{(A)}~Transition probability under the held boundary and three
  endogenous dealer conditions; bands are 95\% Wilson intervals over 50
  seeds. \textbf{(B)}~Difference between endogenous and held-boundary
  transition probabilities across the complete capacity ladder.
  \textbf{(C)}~Median maximum drawdown at $f=0.20$; bands mark the
  interquartile range. \textbf{(D)}~Median fraction of agent-eligible orders
  rejected by the dealer at $f=0.20$. Capacity $h=10$ is omitted because it
  coincided exactly with $h=\infty$ in this campaign.}
  \label{fig:reservoir}
\end{figure}
\efloatseparator
 
\begin{figure}[tb]
  \centering
  \includegraphics[width=0.98\linewidth]{figs/Fig3-DoseMarketPanels.pdf}
  \caption{Prespecified time-sliced markets across the rule-dose crossover
  under an endogenous boundary and unlimited dealer. Blue, gray, and orange
  cells denote Buy, Hold, and Sell. \textbf{(A)}~Lattices for five runs
  (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From
  left to right, the runs include a noncrossing $f=0.15$ case, both outcome
  groups at $f=0.175$, and crossing cases at $f=0.185$ and 0.20.
  Crossing cases were nearest their subgroup median onset; noncrossing cases
  were nearest their subgroup median final Sell fraction. Seeds were 8, 5,
  22, 46, and 21 from left to right. \textbf{(B)}~Price divided by its
  activation value. \textbf{(C)}~Interior Sell fraction; the horizontal line
  marks the majority threshold. Vertical guides mark the four snapshots.}
  \label{fig:dose-panels}
\end{figure}
\efloatseparator
 
\begin{figure}[tb]
  \centering
  \includegraphics[width=0.98\linewidth]{figs/Fig4-DealerMarketPanels.pdf}
  \caption{Time-sliced markets for one matched seed at $f=0.20$.
  \textbf{(A)}~Lattices for four conditions (columns) at activation and after
  500, 1,500, and 3,000 steps (rows). From left to right, the columns contain
  endogenous dealers $h=0.1$, $h=1$, and $h=\infty$, followed by the
  held-boundary control with $h=\infty$. Seed 25
  minimized the summed distance from the three endogenous capacity-specific
  median onsets among seeds that crossed in all three conditions. Rows use
  common elapsed times. \textbf{(B)}~Price divided by its activation value.
  \textbf{(C)}~Interior Sell fraction. The held boundary prevented price from
  changing the lattice; it did not prevent the price from being calculated.}
  \label{fig:dealer-panels}
\end{figure}
\efloatseparator
 
\begin{figure}[tb]
  \centering
  \includegraphics[width=0.97\linewidth]{figs/Fig4-FiniteSizeQuench.pdf}
  \caption{Finite-size response of the paired rule quench over 50 seeds.
  \textbf{(A)}~Held-boundary transition probability; bands are 95\% Wilson
  intervals. \textbf{(B)}~Held-boundary ensemble susceptibility of the final
  500-step Sell fraction. \textbf{(C)}~Interpolated finite-horizon midpoint
  $f_{50}(L)$ for the held control and two endogenous dealer conditions.
  \textbf{(D)}~Peak susceptibility versus lattice size on logarithmic axes.
  Lines connect sampled values; no asymptotic scaling law was fitted.}
  \label{fig:finite-size}
\end{figure}
\efloatseparator
 
\begin{figure}[tb]
  \centering
  \includegraphics[width=0.99\linewidth]{figs/Fig5-BalanceSheetQuench.pdf}
  \caption{Crossed trader cash and share interventions at activation for the
  endogenous boundary, $f=0.18$, and 50 seeds. Columns correspond to dealer
  capacities $h=\infty$, 1, and 0.1; cash multipliers run horizontally and
  share multipliers vertically. \textbf{(A--C)}~Transition probability.
  \textbf{(D--F)}~Median maximum drawdown on one common color scale. The
  matched held-boundary lattice was invariant across all nine interventions.}
  \label{fig:balance-sheet}
\end{figure}
