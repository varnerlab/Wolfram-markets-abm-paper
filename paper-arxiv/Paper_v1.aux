\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Crossed trader cash and share interventions at activation under the endogenous boundary, with $f=0.18$ and 50 seeds. Columns correspond to dealer capacities $h=\infty $, 1, and 0.1; cash multipliers run horizontally and share multipliers vertically. \textbf  {(A--C)}~Transition probability. \textbf  {(D--F)}~Median maximum drawdown on a common color scale. The matched held-boundary lattice was invariant across all nine interventions.}}{13}{figure.caption.27}\protected@file@percent }
\newlabel{fig:balance-sheet}{{6}{13}{Crossed trader cash and share interventions at activation under the endogenous boundary, with $f=0.18$ and 50 seeds. Columns correspond to dealer capacities $h=\infty $, 1, and 0.1; cash multipliers run horizontally and share multipliers vertically. \textbf {(A--C)}~Transition probability. \textbf {(D--F)}~Median maximum drawdown on a common color scale. The matched held-boundary lattice was invariant across all nine interventions}{figure.caption.27}{}}
