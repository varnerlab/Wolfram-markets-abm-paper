\@writefile{loa}{\contentsline {algorithm}{\numberline {S1}{\ignorespaces One Model~B time step, $\tau - 1 \to \tau $, in the order the simulation executes it. Desired orders fill at the standing quote $P_{\tau -1}$ against the submitting cell's own book, the executed imbalance $\varphi _\tau $ generates the new quote $P_\tau $, the moving average and volatility band follow that new quote, each active edge cell reclassifies against its own band, and the totalistic rule updates the strictly interior cells last. Orders the book cannot honor are tallied as suppressed and leave the submitting cell's state untouched. The disposition test on sells and the intervention hook on the books are guarded steps, switched on and off per campaign.}}{29}{algorithm.48}\protected@file@percent }
\newlabel{alg:modelb-step}{{S1}{29}{One Model~B time step, $\tau - 1 \to \tau $, in the order the simulation executes it. Desired orders fill at the standing quote $P_{\tau -1}$ against the submitting cell's own book, the executed imbalance $\varphi _\tau $ generates the new quote $P_\tau $, the moving average and volatility band follow that new quote, each active edge cell reclassifies against its own band, and the totalistic rule updates the strictly interior cells last. Orders the book cannot honor are tallied as suppressed and leave the submitting cell's state untouched. The disposition test on sells and the intervention hook on the books are guarded steps, switched on and off per campaign}{algorithm.48}{}}
\@writefile{toc}{\contentsline {section}{\numberline {C}Escape-Time Censoring and Survival Detail}{29}{appendix.77}\protected@file@percent }
\newlabel{app:censoring}{{C}{29}{Escape-Time Censoring and Survival Detail}{appendix.77}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Model~B regime exemplars from the Stage~2 factorial: a crash-prone run (run 9652) and an oscillatory run (run 5916). \textbf  {(A)}~Price, its exponential moving average, and the EMA band for the crash-prone exemplar, a bubble-and-collapse trajectory ($100 \to 266 \to 83$). \textbf  {(B)}~The same for the oscillatory exemplar, whose price stayed within a few percent of its starting value. \textbf  {(C)}~Interior Buy, Hold, and Sell fractions for the crash-prone exemplar. \textbf  {(D)}~The same for the oscillatory exemplar. \textbf  {(E)}~Suppressed buy and sell orders per step for the crash-prone exemplar. \textbf  {(F)}~The same for the oscillatory exemplar. The crash-prone exemplar is the extreme tail of its regime, shown because it makes the mechanism visible. The \emph  {typical} crash-prone run is a liquidity freeze in which the grid locks near a Sell fraction of $0.88$ while its maximum drawdown stays near $5\%$. ``Crash-prone'' throughout denotes majority-sell lock-in (Sell fraction $\ge 0.5$ on at least 1\% of steps), not a price discontinuity.}}{31}{figure.caption.78}\protected@file@percent }
\newlabel{fig:s1}{{S1}{31}{Model~B regime exemplars from the Stage~2 factorial: a crash-prone run (run 9652) and an oscillatory run (run 5916). \textbf {(A)}~Price, its exponential moving average, and the EMA band for the crash-prone exemplar, a bubble-and-collapse trajectory ($100 \to 266 \to 83$). \textbf {(B)}~The same for the oscillatory exemplar, whose price stayed within a few percent of its starting value. \textbf {(C)}~Interior Buy, Hold, and Sell fractions for the crash-prone exemplar. \textbf {(D)}~The same for the oscillatory exemplar. \textbf {(E)}~Suppressed buy and sell orders per step for the crash-prone exemplar. \textbf {(F)}~The same for the oscillatory exemplar. The crash-prone exemplar is the extreme tail of its regime, shown because it makes the mechanism visible. The \emph {typical} crash-prone run is a liquidity freeze in which the grid locks near a Sell fraction of $0.88$ while its maximum drawdown stays near $5\%$. ``Crash-prone'' throughout denotes majority-sell lock-in (Sell fraction $\ge 0.5$ on at least 1\% of steps), not a price discontinuity}{figure.caption.78}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Model~B seed sweep: largest-sell-cluster trajectories per seed, $20$ disorder seeds per budget configuration. \textbf  {(A)}~Largest sell cluster, expressed as a fraction of the grid, drawn step by step for every seed of the stable configuration ($f = 0.10$, cash $1{,}000$). \textbf  {(B)}~The same for the freeze configuration ($f = 0.20$, cash $500$). \textbf  {(C)}~The same for the collapse configuration ($f = 0.20$, cash $5{,}000$). The time-shifted-sigmoid fan within each above-threshold configuration reflects stochastic nucleation waiting times rather than a spread of eventual outcomes. \textbf  {(D)}~Per-seed ratio of the largest cluster to the total sell population at its peak. The stable configuration sits at a median ratio of $0.022$, dispersed fluctuations with no dominant domain, while the freeze and collapse configurations concentrate into a single growing domain at median ratios of $0.26$ and $0.44$, and the stable band shows zero overlap against either above-threshold configuration. \textbf  {(E)}~The same comparison for the largest-cluster fraction of the grid at the end of the run.}}{32}{figure.caption.79}\protected@file@percent }
\newlabel{fig:s2}{{S2}{32}{Model~B seed sweep: largest-sell-cluster trajectories per seed, $20$ disorder seeds per budget configuration. \textbf {(A)}~Largest sell cluster, expressed as a fraction of the grid, drawn step by step for every seed of the stable configuration ($f = 0.10$, cash $1{,}000$). \textbf {(B)}~The same for the freeze configuration ($f = 0.20$, cash $500$). \textbf {(C)}~The same for the collapse configuration ($f = 0.20$, cash $5{,}000$). The time-shifted-sigmoid fan within each above-threshold configuration reflects stochastic nucleation waiting times rather than a spread of eventual outcomes. \textbf {(D)}~Per-seed ratio of the largest cluster to the total sell population at its peak. The stable configuration sits at a median ratio of $0.022$, dispersed fluctuations with no dominant domain, while the freeze and collapse configurations concentrate into a single growing domain at median ratios of $0.26$ and $0.44$, and the stable band shows zero overlap against either above-threshold configuration. \textbf {(E)}~The same comparison for the largest-cluster fraction of the grid at the end of the run}{figure.caption.79}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Peak sell fraction against the minority fraction~$f$ for Model~A (Rules~19280/19286, $128 \times 128$ grid, fixed seed), the third summary of the sweep, alongside its mean sell fraction and crash frequency (Figure~\ref {fig:crossover}B and~\ref {fig:crossover}C). The dashed vertical line at $f = 0.145$ marks the midpoint of the observed $[0.14,0.15]$ crossover bracket, not a fitted thermodynamic critical point.}}{33}{figure.caption.80}\protected@file@percent }
\newlabel{fig:s3}{{S3}{33}{Peak sell fraction against the minority fraction~$f$ for Model~A (Rules~19280/19286, $128 \times 128$ grid, fixed seed), the third summary of the sweep, alongside its mean sell fraction and crash frequency (Figure~\ref {fig:crossover}B and~\ref {fig:crossover}C). The dashed vertical line at $f = 0.145$ marks the midpoint of the observed $[0.14,0.15]$ crossover bracket, not a fitted thermodynamic critical point}{figure.caption.80}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Onset cliff and fitted barrier parameters across the cash ladder. \textbf  {(A)}~Fraction of seeds that nucleated within the $2{,}000$-step horizon, against the minority fraction~$f$ at cash $500$, $1{,}000$, and $5{,}000$: the onset cliff sits between $f = 0.15$ and $f = 0.18$ at every cash level. \textbf  {(B)}~Fitted pseudo-threshold $f_0$ per cash level with $95\%$ bootstrap confidence intervals; the dashed line marks the Model~A value $f_0 = 0.101$. \textbf  {(C)}~Fitted shape coefficient $B$ on the same footing, against the Model~A value $B = 0.389$. The intervals overlap between tight and loose cash on both parameters. That overlap is not itself a test. The paired equivalence analysis reported in the text is the test, and it bounds the between-budget difference in predicted median onset time to within a factor of two. The resampling behind these intervals is described in Appendix~\ref {app:censoring}. \textbf  {(D)}~Front velocity at $f = 0.20$ arranged by initial cash, one point per included run and a bar at each per-dose median: the medians are U-shaped in cash, highest at cash $250$, lowest near $1{,}000$--$2{,}000$, and rising again at $5{,}000$, while the per-dose median suppression spans only $517$--$595$ orders per step. The supported claim is therefore the pooled and within-dose velocity--suppression relationship (Figure~\ref {fig:growth-gating}C), not a monotone ordering by dose.}}{34}{figure.caption.81}\protected@file@percent }
\newlabel{fig:s4}{{S4}{34}{Onset cliff and fitted barrier parameters across the cash ladder. \textbf {(A)}~Fraction of seeds that nucleated within the $2{,}000$-step horizon, against the minority fraction~$f$ at cash $500$, $1{,}000$, and $5{,}000$: the onset cliff sits between $f = 0.15$ and $f = 0.18$ at every cash level. \textbf {(B)}~Fitted pseudo-threshold $f_0$ per cash level with $95\%$ bootstrap confidence intervals; the dashed line marks the Model~A value $f_0 = 0.101$. \textbf {(C)}~Fitted shape coefficient $B$ on the same footing, against the Model~A value $B = 0.389$. The intervals overlap between tight and loose cash on both parameters. That overlap is not itself a test. The paired equivalence analysis reported in the text is the test, and it bounds the between-budget difference in predicted median onset time to within a factor of two. The resampling behind these intervals is described in Appendix~\ref {app:censoring}. \textbf {(D)}~Front velocity at $f = 0.20$ arranged by initial cash, one point per included run and a bar at each per-dose median: the medians are U-shaped in cash, highest at cash $250$, lowest near $1{,}000$--$2{,}000$, and rising again at $5{,}000$, while the per-dose median suppression spans only $517$--$595$ orders per step. The supported claim is therefore the pooled and within-dose velocity--suppression relationship (Figure~\ref {fig:growth-gating}C), not a monotone ordering by dose}{figure.caption.81}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Stamped-patch seeding detail across placements and configurations. \textbf  {(A)}~Onset step per seed under each arm (an unstamped control and a $3 \times 3$ sell patch stamped at edge (boundary-adjacent), mid, and center placements) for the freeze configuration, with gray lines pairing the same seed across arms; the pairings cross in both directions and no placement advanced onset. The apparent delay under the freeze mid placement (median paired onset advance $-257$ steps, sign-flip $p = 0.0238$) is exploratory, uncorrected across the six-test family and failing the Bonferroni threshold of $0.0083$, a lead rather than a result. \textbf  {(B)}~The same for the collapse configuration. \textbf  {(C)}~Dominance rate per placement for the freeze configuration: the fraction of runs in which the cluster standing largest at onset descends from the stamped patch is $0/20$ in each of the three stamped placements, so the bars are drawn at zero height and the panel states the count as text. \textbf  {(D)}~The same for the collapse configuration, also $0/20$ in each stamped placement, which completes the six configuration-by-placement cells of the design. \textbf  {(E)}~Largest-cluster growth trajectories for a single exemplar seed under each arm in the freeze configuration. \textbf  {(F)}~The same in the collapse configuration. Which arm reaches domain scale first differs between the two configurations rather than tracking the stamped placement, and the domain that grows is in every run one founded away from the patch.}}{35}{figure.caption.82}\protected@file@percent }
\newlabel{fig:s5}{{S5}{35}{Stamped-patch seeding detail across placements and configurations. \textbf {(A)}~Onset step per seed under each arm (an unstamped control and a $3 \times 3$ sell patch stamped at edge (boundary-adjacent), mid, and center placements) for the freeze configuration, with gray lines pairing the same seed across arms; the pairings cross in both directions and no placement advanced onset. The apparent delay under the freeze mid placement (median paired onset advance $-257$ steps, sign-flip $p = 0.0238$) is exploratory, uncorrected across the six-test family and failing the Bonferroni threshold of $0.0083$, a lead rather than a result. \textbf {(B)}~The same for the collapse configuration. \textbf {(C)}~Dominance rate per placement for the freeze configuration: the fraction of runs in which the cluster standing largest at onset descends from the stamped patch is $0/20$ in each of the three stamped placements, so the bars are drawn at zero height and the panel states the count as text. \textbf {(D)}~The same for the collapse configuration, also $0/20$ in each stamped placement, which completes the six configuration-by-placement cells of the design. \textbf {(E)}~Largest-cluster growth trajectories for a single exemplar seed under each arm in the freeze configuration. \textbf {(F)}~The same in the collapse configuration. Which arm reaches domain scale first differs between the two configurations rather than tracking the stamped placement, and the domain that grows is in every run one founded away from the patch}{figure.caption.82}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Full budget-toggle detail: paired, onset-aligned counterfactuals at $f = 0.20$ over the $19$ included seed pairs per arm, with the dashed line marking the toggle at $t_{\mathrm  {on}}$ and the pre-toggle traces coinciding by construction. The edge-ring traces are averaged over the seed pairs, toggled against control. \textbf  {(A)}~Largest sell cluster as a fraction of the grid against steps since onset under injection (cash $\times 10$ on the tight cash-$500$ base), each toggled trajectory drawn over its control. \textbf  {(B)}~Edge-ring Buy fraction under injection. \textbf  {(C)}~Edge-ring Sell fraction under injection; the ring flips from the control's ${\sim }0.5$ Buy and $0$ Sell to $0$ Buy and ${\sim }1.0$ Sell at the toggle. \textbf  {(D)}~Largest sell cluster under the mild withdrawal (cash $\times 0.1$ on the loose cash-$5{,}000$ base). \textbf  {(E)}~Edge-ring Buy fraction under the mild withdrawal. \textbf  {(F)}~Edge-ring Sell fraction under the mild withdrawal. \textbf  {(G)}~Largest sell cluster under the harsh withdrawal (cash $\times 0.01$). \textbf  {(H)}~Edge-ring Buy fraction under the harsh withdrawal. \textbf  {(I)}~Edge-ring Sell fraction under the harsh withdrawal. Either cut lifts the ring's Buy fraction from the control's ${\sim }0.46$ after onset to ${\sim }0.72$--$0.74$ before the transient excess dissipates by ${\sim }200$ steps. The Sell fraction, which in this loose configuration declines from ${\sim }0.37$ before onset to zero just after, remains indistinguishable between control and toggled throughout.}}{36}{figure.caption.83}\protected@file@percent }
\newlabel{fig:s6}{{S6}{36}{Full budget-toggle detail: paired, onset-aligned counterfactuals at $f = 0.20$ over the $19$ included seed pairs per arm, with the dashed line marking the toggle at $t_{\mathrm {on}}$ and the pre-toggle traces coinciding by construction. The edge-ring traces are averaged over the seed pairs, toggled against control. \textbf {(A)}~Largest sell cluster as a fraction of the grid against steps since onset under injection (cash $\times 10$ on the tight cash-$500$ base), each toggled trajectory drawn over its control. \textbf {(B)}~Edge-ring Buy fraction under injection. \textbf {(C)}~Edge-ring Sell fraction under injection; the ring flips from the control's ${\sim }0.5$ Buy and $0$ Sell to $0$ Buy and ${\sim }1.0$ Sell at the toggle. \textbf {(D)}~Largest sell cluster under the mild withdrawal (cash $\times 0.1$ on the loose cash-$5{,}000$ base). \textbf {(E)}~Edge-ring Buy fraction under the mild withdrawal. \textbf {(F)}~Edge-ring Sell fraction under the mild withdrawal. \textbf {(G)}~Largest sell cluster under the harsh withdrawal (cash $\times 0.01$). \textbf {(H)}~Edge-ring Buy fraction under the harsh withdrawal. \textbf {(I)}~Edge-ring Sell fraction under the harsh withdrawal. Either cut lifts the ring's Buy fraction from the control's ${\sim }0.46$ after onset to ${\sim }0.72$--$0.74$ before the transient excess dissipates by ${\sim }200$ steps. The Sell fraction, which in this loose configuration declines from ${\sim }0.37$ before onset to zero just after, remains indistinguishable between control and toggled throughout}{figure.caption.83}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Timing of the Model~A conversion across lattice sizes (Rules~19280/19286, periodic boundaries, no price forcing, twenty disorder seeds per cell, restricted to the cells in which every seed converted so that no horizon-pinned value enters a statistic). \textbf  {(A)}~Coefficient of variation of the conversion time against lattice size at five minority fractions, compared with the $N^{-1/2}$ self-averaging reference (dashed, anchored at $L = 32$). The lowest curve, $f = 0.20$, tracks that reference, while curves nearer the threshold stay flat at small sizes and join it only at larger ones. \textbf  {(B)}~Median conversion time against lattice size at the same five minority fractions, flat in lattice size above $f \approx 0.17$. The clock the conversion runs on is therefore size-independent while the outcome inside a fixed window is not.}}{37}{figure.caption.84}\protected@file@percent }
\newlabel{fig:s7}{{S7}{37}{Timing of the Model~A conversion across lattice sizes (Rules~19280/19286, periodic boundaries, no price forcing, twenty disorder seeds per cell, restricted to the cells in which every seed converted so that no horizon-pinned value enters a statistic). \textbf {(A)}~Coefficient of variation of the conversion time against lattice size at five minority fractions, compared with the $N^{-1/2}$ self-averaging reference (dashed, anchored at $L = 32$). The lowest curve, $f = 0.20$, tracks that reference, while curves nearer the threshold stay flat at small sizes and join it only at larger ones. \textbf {(B)}~Median conversion time against lattice size at the same five minority fractions, flat in lattice size above $f \approx 0.17$. The clock the conversion runs on is therefore size-independent while the outcome inside a fixed window is not}{figure.caption.84}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Model~B Stage~2 factorial design. The six factors are crossed in full: $5 \times 4 \times 3 \times 2 \times 3 \times 3 = 1{,}080$ configurations, each run at $10$ seeds for $2{,}000$ steps ($10{,}800$ runs).}}{38}{table.caption.85}\protected@file@percent }
\newlabel{tab:stage2-design}{{S1}{38}{Model~B Stage~2 factorial design. The six factors are crossed in full: $5 \times 4 \times 3 \times 2 \times 3 \times 3 = 1{,}080$ configurations, each run at $10$ seeds for $2{,}000$ steps ($10{,}800$ runs)}{table.caption.85}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Escape-time campaign: run count $n$, censored count $c$, and onset rate $(n - c)/n$ for every $(f, \text  {cash})$ cell. Rows at $n = 20$ come from the pilot pass, rows at $n = 40$ from the refinement pass. A Kaplan--Meier median is finite only where the onset rate reaches $0.5$. The qualifying cells are exactly the $n_f = 5/6/6$ fit points of Table~\ref {tab:kramers-fits}.}}{39}{table.caption.86}\protected@file@percent }
\newlabel{tab:censoring-counts}{{S2}{39}{Escape-time campaign: run count $n$, censored count $c$, and onset rate $(n - c)/n$ for every $(f, \text {cash})$ cell. Rows at $n = 20$ come from the pilot pass, rows at $n = 40$ from the refinement pass. A Kaplan--Meier median is finite only where the onset rate reaches $0.5$. The qualifying cells are exactly the $n_f = 5/6/6$ fit points of Table~\ref {tab:kramers-fits}}{table.caption.86}{}}
