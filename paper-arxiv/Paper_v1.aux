\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A paired rule quench separated initially identical markets. Fifty seeds were run on a $64\times 64$ lattice for 1,000 baseline steps and 3,000 post-activation steps. The dormant arm retained the same target sites but did not switch their rules. \textbf  {(A)}~Median price divided by its value at activation; bands mark the interquartile range. \textbf  {(B)}~Median interior Sell fraction; the horizontal line marks the majority threshold. \textbf  {(C)}~Time-sliced lattices for seed 12, the $f=0.20$ pair nearest the median treated-control peak-Sell difference. Blue, gray, and orange cells denote Buy, Hold, and Sell. The two rows show the dormant and treated arms from their common activation state through 3,000 steps. All paired paths coincide before the vertical activation line.}}{11}{figure.caption.32}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:rule-quench}{{1}{11}{A paired rule quench separated initially identical markets. Fifty seeds were run on a $64\times 64$ lattice for 1,000 baseline steps and 3,000 post-activation steps. The dormant arm retained the same target sites but did not switch their rules. \textbf {(A)}~Median price divided by its value at activation; bands mark the interquartile range. \textbf {(B)}~Median interior Sell fraction; the horizontal line marks the majority threshold. \textbf {(C)}~Time-sliced lattices for seed 12, the $f=0.20$ pair nearest the median treated-control peak-Sell difference. Blue, gray, and orange cells denote Buy, Hold, and Sell. The two rows show the dormant and treated arms from their common activation state through 3,000 steps. All paired paths coincide before the vertical activation line}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Rule activation across explicit dealer capacities. \textbf  {(A)}~Transition probability under the held boundary and three endogenous dealer conditions; bands are 95\% Wilson intervals over 50 seeds. \textbf  {(B)}~Difference between endogenous and held-boundary transition probabilities across the complete capacity ladder. \textbf  {(C)}~Median maximum drawdown at $f=0.20$; bands mark the interquartile range. \textbf  {(D)}~Median fraction of agent-eligible orders rejected by the dealer at $f=0.20$. Capacity $h=10$ is omitted because it coincided exactly with $h=\infty $ in this campaign.}}{12}{figure.caption.33}\protected@file@percent }
\newlabel{fig:reservoir}{{2}{12}{Rule activation across explicit dealer capacities. \textbf {(A)}~Transition probability under the held boundary and three endogenous dealer conditions; bands are 95\% Wilson intervals over 50 seeds. \textbf {(B)}~Difference between endogenous and held-boundary transition probabilities across the complete capacity ladder. \textbf {(C)}~Median maximum drawdown at $f=0.20$; bands mark the interquartile range. \textbf {(D)}~Median fraction of agent-eligible orders rejected by the dealer at $f=0.20$. Capacity $h=10$ is omitted because it coincided exactly with $h=\infty $ in this campaign}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Prespecified time-sliced markets across the rule-dose crossover under an endogenous boundary and unlimited dealer. Blue, gray, and orange cells denote Buy, Hold, and Sell. \textbf  {(A)}~Lattices for five runs (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From left to right, the runs include a noncrossing $f=0.15$ case, both outcome groups at $f=0.175$, and crossing cases at $f=0.185$ and 0.20. Crossing cases were nearest their subgroup median onset; noncrossing cases were nearest their subgroup median final Sell fraction. Seeds were 8, 5, 22, 46, and 21 from left to right. \textbf  {(B)}~Price divided by its activation value. \textbf  {(C)}~Interior Sell fraction; the horizontal line marks the majority threshold. Vertical guides mark the four snapshots.}}{13}{figure.caption.34}\protected@file@percent }
\newlabel{fig:dose-panels}{{3}{13}{Prespecified time-sliced markets across the rule-dose crossover under an endogenous boundary and unlimited dealer. Blue, gray, and orange cells denote Buy, Hold, and Sell. \textbf {(A)}~Lattices for five runs (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From left to right, the runs include a noncrossing $f=0.15$ case, both outcome groups at $f=0.175$, and crossing cases at $f=0.185$ and 0.20. Crossing cases were nearest their subgroup median onset; noncrossing cases were nearest their subgroup median final Sell fraction. Seeds were 8, 5, 22, 46, and 21 from left to right. \textbf {(B)}~Price divided by its activation value. \textbf {(C)}~Interior Sell fraction; the horizontal line marks the majority threshold. Vertical guides mark the four snapshots}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Time-sliced markets for one matched seed at $f=0.20$. \textbf  {(A)}~Lattices for four conditions (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From left to right, the columns contain endogenous dealers $h=0.1$, $h=1$, and $h=\infty $, followed by the held-boundary control with $h=\infty $. Seed 25 minimized the summed distance from the three endogenous capacity-specific median onsets among seeds that crossed in all three conditions. Rows use common elapsed times. \textbf  {(B)}~Price divided by its activation value. \textbf  {(C)}~Interior Sell fraction. The held boundary prevented price from changing the lattice; it did not prevent the price from being calculated.}}{14}{figure.caption.35}\protected@file@percent }
\newlabel{fig:dealer-panels}{{4}{14}{Time-sliced markets for one matched seed at $f=0.20$. \textbf {(A)}~Lattices for four conditions (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From left to right, the columns contain endogenous dealers $h=0.1$, $h=1$, and $h=\infty $, followed by the held-boundary control with $h=\infty $. Seed 25 minimized the summed distance from the three endogenous capacity-specific median onsets among seeds that crossed in all three conditions. Rows use common elapsed times. \textbf {(B)}~Price divided by its activation value. \textbf {(C)}~Interior Sell fraction. The held boundary prevented price from changing the lattice; it did not prevent the price from being calculated}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Finite-size response of the paired rule quench over 50 seeds. \textbf  {(A)}~Held-boundary transition probability; bands are 95\% Wilson intervals. \textbf  {(B)}~Held-boundary ensemble susceptibility of the final 500-step Sell fraction. \textbf  {(C)}~Interpolated finite-horizon midpoint $f_{50}(L)$ for the held control and two endogenous dealer conditions. \textbf  {(D)}~Peak susceptibility versus lattice size on logarithmic axes. Lines connect sampled values; no asymptotic scaling law was fitted.}}{15}{figure.caption.36}\protected@file@percent }
\newlabel{fig:finite-size}{{5}{15}{Finite-size response of the paired rule quench over 50 seeds. \textbf {(A)}~Held-boundary transition probability; bands are 95\% Wilson intervals. \textbf {(B)}~Held-boundary ensemble susceptibility of the final 500-step Sell fraction. \textbf {(C)}~Interpolated finite-horizon midpoint $f_{50}(L)$ for the held control and two endogenous dealer conditions. \textbf {(D)}~Peak susceptibility versus lattice size on logarithmic axes. Lines connect sampled values; no asymptotic scaling law was fitted}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Crossed trader cash and share interventions at activation for the endogenous boundary, $f=0.18$, and 50 seeds. Columns correspond to dealer capacities $h=\infty $, 1, and 0.1; cash multipliers run horizontally and share multipliers vertically. \textbf  {(A--C)}~Transition probability. \textbf  {(D--F)}~Median maximum drawdown on one common color scale. The matched held-boundary lattice was invariant across all nine interventions.}}{16}{figure.caption.37}\protected@file@percent }
\newlabel{fig:balance-sheet}{{6}{16}{Crossed trader cash and share interventions at activation for the endogenous boundary, $f=0.18$, and 50 seeds. Columns correspond to dealer capacities $h=\infty $, 1, and 0.1; cash multipliers run horizontally and share multipliers vertically. \textbf {(A--C)}~Transition probability. \textbf {(D--F)}~Median maximum drawdown on one common color scale. The matched held-boundary lattice was invariant across all nine interventions}{figure.caption.37}{}}
