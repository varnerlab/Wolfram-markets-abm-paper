\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A paired mid-run rule switch separated initially identical market paths. Fifty seeds were run on a $64\times 64$ lattice for 1,000 baseline steps and 3,000 post-activation steps. The no-switch path retained the same target sites but kept their baseline rules. \textbf  {(A)}~Median price divided by its value at activation; bands mark the interquartile range. \textbf  {(B)}~Median interior Sell fraction; the horizontal line marks the majority threshold. \textbf  {(C)}~Time-sliced lattices for seed 12, the $f=0.20$ pair nearest the median switched-control difference in peak Sell fraction. Blue, gray, and orange cells denote Buy, Hold, and Sell. The rows show the no-switch and switched paths from their common activation state through 3,000 steps. All paired paths coincided before the vertical activation line.}}{7}{figure.caption.22}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:rule-quench}{{1}{7}{A paired mid-run rule switch separated initially identical market paths. Fifty seeds were run on a $64\times 64$ lattice for 1,000 baseline steps and 3,000 post-activation steps. The no-switch path retained the same target sites but kept their baseline rules. \textbf {(A)}~Median price divided by its value at activation; bands mark the interquartile range. \textbf {(B)}~Median interior Sell fraction; the horizontal line marks the majority threshold. \textbf {(C)}~Time-sliced lattices for seed 12, the $f=0.20$ pair nearest the median switched-control difference in peak Sell fraction. Blue, gray, and orange cells denote Buy, Hold, and Sell. The rows show the no-switch and switched paths from their common activation state through 3,000 steps. All paired paths coincided before the vertical activation line}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Rule activation across dealer capacities. \textbf  {(A)}~Transition probability under the held boundary and three endogenous dealer conditions; bands are 95\% Wilson intervals over 50 seeds. The held boundary kept active boundary traders in the Hold state. \textbf  {(B)}~Difference between endogenous and held-boundary transition probabilities across the complete capacity range. \textbf  {(C)}~Median maximum drawdown at $f=0.20$; bands mark the interquartile range. \textbf  {(D)}~Median fraction of agent-eligible orders rejected by the dealer at $f=0.20$. Capacity $h=10$ is omitted because it coincided exactly with $h=\infty $ in this campaign.}}{8}{figure.caption.23}\protected@file@percent }
\newlabel{fig:reservoir}{{2}{8}{Rule activation across dealer capacities. \textbf {(A)}~Transition probability under the held boundary and three endogenous dealer conditions; bands are 95\% Wilson intervals over 50 seeds. The held boundary kept active boundary traders in the Hold state. \textbf {(B)}~Difference between endogenous and held-boundary transition probabilities across the complete capacity range. \textbf {(C)}~Median maximum drawdown at $f=0.20$; bands mark the interquartile range. \textbf {(D)}~Median fraction of agent-eligible orders rejected by the dealer at $f=0.20$. Capacity $h=10$ is omitted because it coincided exactly with $h=\infty $ in this campaign}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Finite-size response of the paired rule switch over 50 seeds. \textbf  {(A)}~Held-boundary transition probability; bands are 95\% Wilson intervals. \textbf  {(B)}~Held-boundary ensemble susceptibility of the final 500-step Sell fraction. \textbf  {(C)}~Interpolated finite-horizon midpoint $f_{50}(L)$ for the held control and two endogenous dealer conditions. \textbf  {(D)}~Peak susceptibility versus lattice size on logarithmic axes. Lines connect sampled values; no asymptotic scaling law was fitted.}}{9}{figure.caption.24}\protected@file@percent }
\newlabel{fig:finite-size}{{3}{9}{Finite-size response of the paired rule switch over 50 seeds. \textbf {(A)}~Held-boundary transition probability; bands are 95\% Wilson intervals. \textbf {(B)}~Held-boundary ensemble susceptibility of the final 500-step Sell fraction. \textbf {(C)}~Interpolated finite-horizon midpoint $f_{50}(L)$ for the held control and two endogenous dealer conditions. \textbf {(D)}~Peak susceptibility versus lattice size on logarithmic axes. Lines connect sampled values; no asymptotic scaling law was fitted}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Prespecified time-sliced markets across the activation-fraction crossover under an endogenous boundary and unlimited dealer. Blue, gray, and orange cells denote Buy, Hold, and Sell. \textbf  {(A)}~Lattices for five runs (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From left to right, the runs include a noncrossing $f=0.15$ case, both outcome groups at $f=0.175$, and crossing cases at $f=0.185$ and 0.20. Crossing cases were nearest their subgroup median onset; noncrossing cases were nearest their subgroup median final Sell fraction. Seeds were 8, 5, 22, 46, and 21 from left to right. \textbf  {(B)}~Price divided by its activation value. \textbf  {(C)}~Interior Sell fraction; the horizontal line marks the majority threshold. Vertical guides mark the four snapshots.}}{10}{figure.caption.25}\protected@file@percent }
\newlabel{fig:dose-panels}{{4}{10}{Prespecified time-sliced markets across the activation-fraction crossover under an endogenous boundary and unlimited dealer. Blue, gray, and orange cells denote Buy, Hold, and Sell. \textbf {(A)}~Lattices for five runs (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From left to right, the runs include a noncrossing $f=0.15$ case, both outcome groups at $f=0.175$, and crossing cases at $f=0.185$ and 0.20. Crossing cases were nearest their subgroup median onset; noncrossing cases were nearest their subgroup median final Sell fraction. Seeds were 8, 5, 22, 46, and 21 from left to right. \textbf {(B)}~Price divided by its activation value. \textbf {(C)}~Interior Sell fraction; the horizontal line marks the majority threshold. Vertical guides mark the four snapshots}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Time-sliced markets for one matched seed at $f=0.20$. \textbf  {(A)}~Lattices for four conditions (columns) at activation and after 500, 1,500, and 3,000 steps (rows). The columns contain endogenous dealers with $h=0.1$, $h=1$, and $h=\infty $, followed by the held-boundary control with $h=\infty $. Seed 25 minimized the summed distance from the three endogenous capacity-specific median onsets among seeds that crossed in all three conditions. Rows use common elapsed times. \textbf  {(B)}~Price divided by its activation value. \textbf  {(C)}~Interior Sell fraction. The held boundary prevented price from changing the lattice but did not prevent price from being calculated.}}{12}{figure.caption.26}\protected@file@percent }
\newlabel{fig:dealer-panels}{{5}{12}{Time-sliced markets for one matched seed at $f=0.20$. \textbf {(A)}~Lattices for four conditions (columns) at activation and after 500, 1,500, and 3,000 steps (rows). The columns contain endogenous dealers with $h=0.1$, $h=1$, and $h=\infty $, followed by the held-boundary control with $h=\infty $. Seed 25 minimized the summed distance from the three endogenous capacity-specific median onsets among seeds that crossed in all three conditions. Rows use common elapsed times. \textbf {(B)}~Price divided by its activation value. \textbf {(C)}~Interior Sell fraction. The held boundary prevented price from changing the lattice but did not prevent price from being calculated}{figure.caption.26}{}}
