\@writefile{loa}{\contentsline {algorithm}{\numberline {S1}{\ignorespaces One endogenous-market step, $t-1\rightarrow t$, in simulation order. Orders came from the old interior and boundary states, settled at the old quote, and generated the new quote. The new quote set the boundary before the interior cellular automaton update.}}{16}{algorithm.33}\protected@file@percent }
\newlabel{alg:model-step}{{S1}{16}{One endogenous-market step, $t-1\rightarrow t$, in simulation order. Orders came from the old interior and boundary states, settled at the old quote, and generated the new quote. The new quote set the boundary before the interior cellular automaton update}{algorithm.33}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {S2}{\ignorespaces Order eligibility, dealer clearing, rationing, and settlement at $P_{t-1}$. The finite dealer filled only the unmatched residual. The $h=\infty $ branch filled every eligible order.}}{17}{algorithm.60}\protected@file@percent }
\newlabel{alg:dealer-clearing}{{S2}{17}{Order eligibility, dealer clearing, rationing, and settlement at $P_{t-1}$. The finite dealer filled only the unmatched residual. The $h=\infty $ branch filled every eligible order}{algorithm.60}{}}
