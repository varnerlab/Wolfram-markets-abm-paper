\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Selected paired-switch campaign on a $64\times 64$ lattice with an unlimited dealer and an endogenous boundary. Transition probability is the fraction of seeds whose peak interior Sell fraction reached one half after activation. Median onset is taken over crossing seeds and is undefined where no seed crossed.}}{13}{table.caption.29}\protected@file@percent }
\newlabel{tab:paired-switch}{{S2}{13}{Selected paired-switch campaign on a $64\times 64$ lattice with an unlimited dealer and an endogenous boundary. Transition probability is the fraction of seeds whose peak interior Sell fraction reached one half after activation. Median onset is taken over crossing seeds and is undefined where no seed crossed}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Refined finite-size response over 50 seeds and 3,000 post-activation steps. Brackets give 95\% confidence intervals (CI) from seed resampling. $n_{\rm  int}$ counts fractions with $0.05<\hat  p<0.95$. Crossings use linear interpolation. The susceptibility maximum is over the sampled grid, and its interval includes reselection of that maximum within each bootstrap replicate. Intervals condition on the refined grid.}}{13}{table.caption.30}\protected@file@percent }
\newlabel{tab:finite-size-scaling}{{S3}{13}{Refined finite-size response over 50 seeds and 3,000 post-activation steps. Brackets give 95\% confidence intervals (CI) from seed resampling. $n_{\rm int}$ counts fractions with $0.05<\hat p<0.95$. Crossings use linear interpolation. The susceptibility maximum is over the sampled grid, and its interval includes reselection of that maximum within each bootstrap replicate. Intervals condition on the refined grid}{table.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Transition probability in the cash--share campaign over 50 seeds. Each fraction contains 27 held-boundary cells, which returned one common value, and 27 endogenous cells spanning the stated range across the three-by-three cash--share grid and three dealer capacities.}}{13}{table.caption.31}\protected@file@percent }
\newlabel{tab:balance-fractions}{{S4}{13}{Transition probability in the cash--share campaign over 50 seeds. Each fraction contains 27 held-boundary cells, which returned one common value, and 27 endogenous cells spanning the stated range across the three-by-three cash--share grid and three dealer capacities}{table.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Matched one-time Sell pulse and persistent Rule~19286 activation. Each arm used the same target sites and 3,000 post-intervention steps. Entries are majority probabilities with 95\% Wilson intervals; the dealer was unlimited under both boundary conditions.}}{14}{table.caption.32}\protected@file@percent }
\newlabel{tab:revision-pulse}{{S5}{14}{Matched one-time Sell pulse and persistent Rule~19286 activation. Each arm used the same target sites and 3,000 post-intervention steps. Entries are majority probabilities with 95\% Wilson intervals; the dealer was unlimited under both boundary conditions}{table.caption.32}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces Single-entry neighbors of Rule~19280. Each probability pair is held / endogenous boundary over 20 seeds; the intervention is persistent. The output labels are Buy $=0$, Hold $=1$, Sell $=2$.}}{14}{table.caption.33}\protected@file@percent }
\newlabel{tab:revision-rules}{{S6}{14}{Single-entry neighbors of Rule~19280. Each probability pair is held / endogenous boundary over 20 seeds; the intervention is persistent. The output labels are Buy $=0$, Hold $=1$, Sell $=2$}{table.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces Band-deviation control at $f=0.175$ over 50 seeds. Probability brackets are 95\% Wilson confidence intervals (CI). Boundary Sell occupancy is the mean fraction of active boundary traders in Sell over post-switch steps and seeds.}}{14}{table.caption.34}\protected@file@percent }
\newlabel{tab:revision-band}{{S7}{14}{Band-deviation control at $f=0.175$ over 50 seeds. Probability brackets are 95\% Wilson confidence intervals (CI). Boundary Sell occupancy is the mean fraction of active boundary traders in Sell over post-switch steps and seeds}{table.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S8}{\ignorespaces Price-impact sweep at $f=0.20$ under the endogenous boundary, 50 seeds per cell. Drawdown is a percentage; rejection is the fraction of post-switch eligible orders rejected.}}{15}{table.caption.35}\protected@file@percent }
\newlabel{tab:revision-impact}{{S8}{15}{Price-impact sweep at $f=0.20$ under the endogenous boundary, 50 seeds per cell. Drawdown is a percentage; rejection is the fraction of post-switch eligible orders rejected}{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S9}{\ignorespaces Held-boundary horizon and threshold sensitivity, 50 seeds. Entries are interpolated $f_{50}$ [95\% seed-bootstrap interval] for each crossing criterion. The horizon grids are independent of adaptive refinement, so their interpolated values can differ slightly from Supplementary Table~\ref {tab:finite-size-scaling}.}}{15}{table.caption.36}\protected@file@percent }
\newlabel{tab:revision-horizons}{{S9}{15}{Held-boundary horizon and threshold sensitivity, 50 seeds. Entries are interpolated $f_{50}$ [95\% seed-bootstrap interval] for each crossing criterion. The horizon grids are independent of adaptive refinement, so their interpolated values can differ slightly from Supplementary Table~\ref {tab:finite-size-scaling}}{table.caption.36}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S10}{\ignorespaces Logistic shape sensitivity on the refined grids. Parentheses give seed-bootstrap standard errors (SE), not binomial standard errors treating fractions as independent. The last column is the location of the empirical susceptibility maximum: it is a sampled fraction with local grid resolution, not an interpolated optimum.}}{15}{table.caption.37}\protected@file@percent }
\newlabel{tab:revision-fits}{{S10}{15}{Logistic shape sensitivity on the refined grids. Parentheses give seed-bootstrap standard errors (SE), not binomial standard errors treating fractions as independent. The last column is the location of the empirical susceptibility maximum: it is a sampled fraction with local grid resolution, not an interpolated optimum}{table.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A paired mid-run rule switch separated initially identical market paths. Fifty seeds were run on a $64\times 64$ lattice for 1,000 baseline steps and 3,000 post-activation steps. The no-switch path retained the same target sites but kept their baseline rules. \textbf  {(A)}~Median price divided by its value at activation; bands mark the interquartile range. \textbf  {(B)}~Median interior Sell fraction; the horizontal line marks the majority threshold. \textbf  {(C)}~Time-sliced lattices for seed 12, the $f=0.20$ pair nearest the median switched-control difference in peak Sell fraction. Blue, gray, and orange cells denote Buy, Hold, and Sell. The rows show the no-switch and switched paths from their common activation state through 3,000 steps. All paired paths coincided before the vertical activation line.}}{16}{figure.caption.39}\protected@file@percent }
\newlabel{fig:rule-quench}{{1}{16}{A paired mid-run rule switch separated initially identical market paths. Fifty seeds were run on a $64\times 64$ lattice for 1,000 baseline steps and 3,000 post-activation steps. The no-switch path retained the same target sites but kept their baseline rules. \textbf {(A)}~Median price divided by its value at activation; bands mark the interquartile range. \textbf {(B)}~Median interior Sell fraction; the horizontal line marks the majority threshold. \textbf {(C)}~Time-sliced lattices for seed 12, the $f=0.20$ pair nearest the median switched-control difference in peak Sell fraction. Blue, gray, and orange cells denote Buy, Hold, and Sell. The rows show the no-switch and switched paths from their common activation state through 3,000 steps. All paired paths coincided before the vertical activation line}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Rule activation across dealer capacities. \textbf  {(A)}~Transition probability under the held boundary and selected endogenous dealer conditions; bands are 95\% Wilson intervals over 50 seeds. The held boundary kept active boundary traders in the Hold state. \textbf  {(B)}~Difference between endogenous and held-boundary transition probabilities across the complete capacity range. \textbf  {(C)}~Median maximum drawdown at $f=0.20$; bands mark the interquartile range. \textbf  {(D)}~Median fraction of agent-eligible orders rejected by the dealer at $f=0.20$. Capacity $h=10$ is shown as a dashed overlay in (A) and as an explicit capacity level in (B--D); it coincided exactly with $h=\infty $.}}{17}{figure.caption.40}\protected@file@percent }
\newlabel{fig:reservoir}{{2}{17}{Rule activation across dealer capacities. \textbf {(A)}~Transition probability under the held boundary and selected endogenous dealer conditions; bands are 95\% Wilson intervals over 50 seeds. The held boundary kept active boundary traders in the Hold state. \textbf {(B)}~Difference between endogenous and held-boundary transition probabilities across the complete capacity range. \textbf {(C)}~Median maximum drawdown at $f=0.20$; bands mark the interquartile range. \textbf {(D)}~Median fraction of agent-eligible orders rejected by the dealer at $f=0.20$. Capacity $h=10$ is shown as a dashed overlay in (A) and as an explicit capacity level in (B--D); it coincided exactly with $h=\infty $}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Finite-size response of the paired rule switch over 50 seeds. \textbf  {(A)}~Held-boundary transition probability; bands are 95\% Wilson intervals. \textbf  {(B)}~Held-boundary ensemble susceptibility of the final 500-step mean Sell fraction. \textbf  {(C)}~Interpolated finite-horizon midpoint $f_{50}(L)$ for the held control and two endogenous dealer conditions. \textbf  {(D)}~Peak susceptibility versus lattice size on linear axes. Error bars in (C,D) are 95\% seed-bootstrap intervals. Solid lines connect sampled values; dashed curves in (A) are logistic fits. No asymptotic scaling law was fitted.}}{18}{figure.caption.41}\protected@file@percent }
\newlabel{fig:finite-size}{{3}{18}{Finite-size response of the paired rule switch over 50 seeds. \textbf {(A)}~Held-boundary transition probability; bands are 95\% Wilson intervals. \textbf {(B)}~Held-boundary ensemble susceptibility of the final 500-step mean Sell fraction. \textbf {(C)}~Interpolated finite-horizon midpoint $f_{50}(L)$ for the held control and two endogenous dealer conditions. \textbf {(D)}~Peak susceptibility versus lattice size on linear axes. Error bars in (C,D) are 95\% seed-bootstrap intervals. Solid lines connect sampled values; dashed curves in (A) are logistic fits. No asymptotic scaling law was fitted}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Prespecified time-sliced markets across the activation-fraction crossover under an endogenous boundary and unlimited dealer. Blue, gray, and orange cells denote Buy, Hold, and Sell. \textbf  {(A)}~Lattices for five runs (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From left to right, the runs include a noncrossing $f=0.15$ case, both outcome groups at $f=0.175$, and crossing cases at $f=0.185$ and 0.20. Crossing cases were nearest their subgroup median onset. Noncrossing cases were nearest their subgroup median final Sell fraction. Seeds were 8, 5, 22, 46, and 21 from left to right. \textbf  {(B)}~Price divided by its activation value. \textbf  {(C)}~Interior Sell fraction; the horizontal line marks the majority threshold. Vertical guides mark the four snapshots.}}{19}{figure.caption.42}\protected@file@percent }
\newlabel{fig:dose-panels}{{4}{19}{Prespecified time-sliced markets across the activation-fraction crossover under an endogenous boundary and unlimited dealer. Blue, gray, and orange cells denote Buy, Hold, and Sell. \textbf {(A)}~Lattices for five runs (columns) at activation and after 500, 1,500, and 3,000 steps (rows). From left to right, the runs include a noncrossing $f=0.15$ case, both outcome groups at $f=0.175$, and crossing cases at $f=0.185$ and 0.20. Crossing cases were nearest their subgroup median onset. Noncrossing cases were nearest their subgroup median final Sell fraction. Seeds were 8, 5, 22, 46, and 21 from left to right. \textbf {(B)}~Price divided by its activation value. \textbf {(C)}~Interior Sell fraction; the horizontal line marks the majority threshold. Vertical guides mark the four snapshots}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Time-sliced markets for one matched seed at $f=0.20$. \textbf  {(A)}~Lattices for four conditions (columns) at activation and after 500, 1,500, and 3,000 steps (rows). The columns contain endogenous dealers with $h=0.1$, $h=1$, and $h=\infty $, followed by the held-boundary control with $h=\infty $. Seed 25 minimized the summed distance from the three endogenous capacity-specific median onsets among seeds that crossed in all three conditions. Rows use common elapsed times. \textbf  {(B)}~Price divided by its activation value. \textbf  {(C)}~Interior Sell fraction. The held boundary prevented price from changing the lattice but did not prevent price from being calculated. The single seed illustrates trajectories; the capacity comparison supplies ensemble evidence (Fig.~\ref {fig:reservoir}).}}{20}{figure.caption.43}\protected@file@percent }
\newlabel{fig:dealer-panels}{{5}{20}{Time-sliced markets for one matched seed at $f=0.20$. \textbf {(A)}~Lattices for four conditions (columns) at activation and after 500, 1,500, and 3,000 steps (rows). The columns contain endogenous dealers with $h=0.1$, $h=1$, and $h=\infty $, followed by the held-boundary control with $h=\infty $. Seed 25 minimized the summed distance from the three endogenous capacity-specific median onsets among seeds that crossed in all three conditions. Rows use common elapsed times. \textbf {(B)}~Price divided by its activation value. \textbf {(C)}~Interior Sell fraction. The held boundary prevented price from changing the lattice but did not prevent price from being calculated. The single seed illustrates trajectories; the capacity comparison supplies ensemble evidence (Fig.~\ref {fig:reservoir})}{figure.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Crossed trader cash and share interventions at activation under the endogenous boundary, with $f=0.18$ and 50 seeds. In panels A to C the nine intervention cells are grouped by cash multiplier with the share multiplier on the axis, and each series is one dealer capacity. \textbf  {(A)}~Transition probability. The dashed line and band give the held-boundary value and its 95\% Wilson interval, which were identical in all nine cells because the held-boundary lattice was invariant to every intervention. \textbf  {(B)}~Median maximum drawdown on a logarithmic axis. Medians of exactly zero are drawn at the axis floor with open markers. \textbf  {(C)}~Median fraction of agent-eligible orders rejected by the dealer. \textbf  {(D)}~Transition probability against median maximum drawdown for all 27 endogenous cells, on the same logarithmic axis and with zero medians drawn as in B, with the held-boundary reference repeated.}}{21}{figure.caption.44}\protected@file@percent }
\newlabel{fig:balance-sheet}{{6}{21}{Crossed trader cash and share interventions at activation under the endogenous boundary, with $f=0.18$ and 50 seeds. In panels A to C the nine intervention cells are grouped by cash multiplier with the share multiplier on the axis, and each series is one dealer capacity. \textbf {(A)}~Transition probability. The dashed line and band give the held-boundary value and its 95\% Wilson interval, which were identical in all nine cells because the held-boundary lattice was invariant to every intervention. \textbf {(B)}~Median maximum drawdown on a logarithmic axis. Medians of exactly zero are drawn at the axis floor with open markers. \textbf {(C)}~Median fraction of agent-eligible orders rejected by the dealer. \textbf {(D)}~Transition probability against median maximum drawdown for all 27 endogenous cells, on the same logarithmic axis and with zero medians drawn as in B, with the held-boundary reference repeated}{figure.caption.44}{}}
