\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Empirical onset-time fits under budgets. (Top left) Kaplan--Meier median onset times (points) against the minority fraction $f$ at cash $500$, $1{,}000$, and $5{,}000$, each with its fitted divergence $\ln \tilde  \tau = A + B/(f - f_0)$ (solid curves) and the Model~A fit of Equation~\eqref  {eq:kramers} dashed for reference; the fitted curves are drawn only up to a display ceiling so that the medians are not crushed by the divergence near $f_0$. (Top right) Fraction of seeds that nucleated within the $2{,}000$-step horizon: the onset cliff sits between $f = 0.15$ and $f = 0.18$ at every cash level. (Bottom row) Fitted pseudo-threshold $f_0$ (left) and shape coefficient $B$ (right) per cash level, with $95\%$ bootstrap confidence intervals; the dashed lines mark the Model~A values $f_0 = 0.101$ and $B = 0.389$. The intervals overlap between tight and loose cash on both parameters; this overlap does not establish equivalence. Censoring at the horizon and its handling in the medians are detailed in Appendix~\ref {app:censoring}.}}{18}{figure.caption.55}\protected@file@percent }
\newlabel{fig:mb-barrier}{{8}{18}{Empirical onset-time fits under budgets. (Top left) Kaplan--Meier median onset times (points) against the minority fraction $f$ at cash $500$, $1{,}000$, and $5{,}000$, each with its fitted divergence $\ln \tilde \tau = A + B/(f - f_0)$ (solid curves) and the Model~A fit of Equation~\eqref {eq:kramers} dashed for reference; the fitted curves are drawn only up to a display ceiling so that the medians are not crushed by the divergence near $f_0$. (Top right) Fraction of seeds that nucleated within the $2{,}000$-step horizon: the onset cliff sits between $f = 0.15$ and $f = 0.18$ at every cash level. (Bottom row) Fitted pseudo-threshold $f_0$ (left) and shape coefficient $B$ (right) per cash level, with $95\%$ bootstrap confidence intervals; the dashed lines mark the Model~A values $f_0 = 0.101$ and $B = 0.389$. The intervals overlap between tight and loose cash on both parameters; this overlap does not establish equivalence. Censoring at the horizon and its handling in the medians are detailed in Appendix~\ref {app:censoring}}{figure.caption.55}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Empirical fits $\ln \tilde  \tau = A + B/(f - f_0)$ to Kaplan--Meier median onset times, per cash level, with the Model~A fit for reference. The Model~A row is the mean-lifetime fit of Equation~\eqref  {eq:kramers}; the Model~B rows fit Kaplan--Meier medians. Brackets are 95\% bootstrap CIs (2{,}000 resamples of seeds within each~$f$). The cash-500 $f_0$ lower bound of $0.000$ is the physical boundary of the fit domain, not a data quantile. CIs overlap between tight (500) and loose (5000) cash on both $B$ and $f_0$, but this overlap does not establish parameter equality.}}{19}{table.caption.56}\protected@file@percent }
\newlabel{tab:kramers-fits}{{2}{19}{Empirical fits $\ln \tilde \tau = A + B/(f - f_0)$ to Kaplan--Meier median onset times, per cash level, with the Model~A fit for reference. The Model~A row is the mean-lifetime fit of Equation~\eqref {eq:kramers}; the Model~B rows fit Kaplan--Meier medians. Brackets are 95\% bootstrap CIs (2{,}000 resamples of seeds within each~$f$). The cash-500 $f_0$ lower bound of $0.000$ is the physical boundary of the fit domain, not a data quantile. CIs overlap between tight (500) and loose (5000) cash on both $B$ and $f_0$, but this overlap does not establish parameter equality}{table.caption.56}{}}
