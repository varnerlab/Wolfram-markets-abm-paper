\@writefile{loa}{\contentsline {algorithm}{\numberline {S2}{\ignorespaces Order eligibility, dealer clearing, rationing, and settlement at $P_{t-1}$. The finite dealer filled only the unmatched residual. The $h=\infty $ branch filled every eligible order.}}{24}{algorithm.57}\protected@file@percent }
