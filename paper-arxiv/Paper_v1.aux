\@writefile{loa}{\contentsline {algorithm}{\numberline {S1}{\ignorespaces One market step with edge traders responding to price, $t-1\rightarrow t$, in simulation order. Orders came from the old interior and boundary states, settled at the old quote, and generated the new quote. The new quote set the boundary before the interior cellular automaton update.}}{23}{algorithm.47}\protected@file@percent }
\newlabel{alg:model-step}{{S1}{23}{One market step with edge traders responding to price, $t-1\rightarrow t$, in simulation order. Orders came from the old interior and boundary states, settled at the old quote, and generated the new quote. The new quote set the boundary before the interior cellular automaton update}{algorithm.47}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {S2}{\ignorespaces Order eligibility, dealer clearing, rationing, and settlement at $P_{t-1}$. The finite dealer filled only orders that other traders did not match. The $h=\infty $ branch filled every eligible order.}}{24}{algorithm.74}\protected@file@percent }
\newlabel{alg:dealer-clearing}{{S2}{24}{Order eligibility, dealer clearing, rationing, and settlement at $P_{t-1}$. The finite dealer filled only orders that other traders did not match. The $h=\infty $ branch filled every eligible order}{algorithm.74}{}}
