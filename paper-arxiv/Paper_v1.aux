\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Model architecture. \textbf  {(A)}~Agent grid ($N_r \times N_c$) with three states (Buy, Hold, Sell). Green boundary cells are edge agents; dashed-outline interior cells follow the minority rule~(19286); solid interior cells follow the majority rule~(19280). The outlined cell and its Von~Neumann neighbors are expanded in~B. \textbf  {(B)}~CA update for the outlined cell: the four neighbor states are summed to $c_{r,c} = 5$, the sum indexes the rule table, and both rules output Hold, so the next state is $s'_{r,c} = 1$. The two rules differ only at $c = 1$ (shaded column).}}{18}{figure.caption.28}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:schematic}{{1}{18}{Model architecture. \textbf {(A)}~Agent grid ($N_r \times N_c$) with three states (Buy, Hold, Sell). Green boundary cells are edge agents; dashed-outline interior cells follow the minority rule~(19286); solid interior cells follow the majority rule~(19280). The outlined cell and its Von~Neumann neighbors are expanded in~B. \textbf {(B)}~CA update for the outlined cell: the four neighbor states are summed to $c_{r,c} = 5$, the sum indexes the rule table, and both rules output Hold, so the next state is $s'_{r,c} = 1$. The two rules differ only at $c = 1$ (shaded column)}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The Model~A crossover (Rules~19280/19286, QQQ 2024 Q1 data). \textbf  {(A)}~Spatiotemporal snapshots of the $256 \times 256$ agent grid at four logarithmically spaced times ($t = 581$, $2{,}851$, $8{,}236$, and $23{,}790$) and three minority fractions ($f = 0$, $f = 0.15$, and $f = 0.20$), with blue for Buy, gray for Hold, and orange for Sell. At $f = 0.15$ and $t = 8{,}236$ a sell cascade nucleated from a localized seed and propagated as a coherent wavefront before engulfing the grid. \textbf  {(B)}~Mean sell fraction against the minority fraction~$f$ over a fixed-seed sweep on a $128 \times 128$ grid. \textbf  {(C)}~Crash frequency, the fraction of time steps whose sell fraction exceeds $0.50$, over the same sweep. The dashed vertical line at $f = 0.145$ marks the midpoint of the observed $[0.14,0.15]$ crossover bracket, not a fitted thermodynamic critical point. Peak sell fraction over the same sweep is given in Figure~\ref {fig:s3}.}}{19}{figure.caption.29}\protected@file@percent }
\newlabel{fig:crossover}{{2}{19}{The Model~A crossover (Rules~19280/19286, QQQ 2024 Q1 data). \textbf {(A)}~Spatiotemporal snapshots of the $256 \times 256$ agent grid at four logarithmically spaced times ($t = 581$, $2{,}851$, $8{,}236$, and $23{,}790$) and three minority fractions ($f = 0$, $f = 0.15$, and $f = 0.20$), with blue for Buy, gray for Hold, and orange for Sell. At $f = 0.15$ and $t = 8{,}236$ a sell cascade nucleated from a localized seed and propagated as a coherent wavefront before engulfing the grid. \textbf {(B)}~Mean sell fraction against the minority fraction~$f$ over a fixed-seed sweep on a $128 \times 128$ grid. \textbf {(C)}~Crash frequency, the fraction of time steps whose sell fraction exceeds $0.50$, over the same sweep. The dashed vertical line at $f = 0.145$ marks the midpoint of the observed $[0.14,0.15]$ crossover bracket, not a fitted thermodynamic critical point. Peak sell fraction over the same sweep is given in Figure~\ref {fig:s3}}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces System-size dependence of the Model~A crossover (Rules~19280/19286, periodic boundaries, no price forcing, twenty disorder seeds per cell). \textbf  {(A)}~One grid per lattice size, $L = 64$, $128$, and $512$, each at $f = 0.15$, seed~$1$, and the same absolute time $t = 17{,}235$~steps, with blue for Buy, gray for Hold, and orange for Sell. At that one clock reading the smallest lattice was still mixed, at a sell fraction of $0.28$, the middle one was part converted at $0.65$, and the largest had gone over to Sell at $0.99$, so what a fixed window records depends on the size of the market it watches. \textbf  {(B)}~Fraction of seeds converting within the $100{,}000$-step horizon against~$f$ for those same three sizes, with Wilson score intervals and each curve labeled by a same-colored leader line in the open region above the transition. Larger lattices convert at lower~$f$. The dotted curve is the fraction of runs, pooled over all five sizes, in which a $100$-cell sell cluster was ever seen; such clusters appear even where nothing converts, so what moves with size is spreading rather than clustering. This is a descriptive threshold and not a certified critical nucleus. \textbf  {(C)}~All $320$~conversion curves plotted against time rescaled by each run's own fitted rate constant, with $1 - \exp (-u^{n})$ overlaid at $n = 2.22$, the mean fitted exponent on the largest lattice. Sizes lie on top of one another; the band tightens with size, and $64 \times 64$, the smallest lattice fitted, visibly fails to collapse. The dispersion and timing of the conversion times themselves are given in Figure~\ref {fig:s7}.}}{20}{figure.caption.30}\protected@file@percent }
\newlabel{fig:finite-size}{{3}{20}{System-size dependence of the Model~A crossover (Rules~19280/19286, periodic boundaries, no price forcing, twenty disorder seeds per cell). \textbf {(A)}~One grid per lattice size, $L = 64$, $128$, and $512$, each at $f = 0.15$, seed~$1$, and the same absolute time $t = 17{,}235$~steps, with blue for Buy, gray for Hold, and orange for Sell. At that one clock reading the smallest lattice was still mixed, at a sell fraction of $0.28$, the middle one was part converted at $0.65$, and the largest had gone over to Sell at $0.99$, so what a fixed window records depends on the size of the market it watches. \textbf {(B)}~Fraction of seeds converting within the $100{,}000$-step horizon against~$f$ for those same three sizes, with Wilson score intervals and each curve labeled by a same-colored leader line in the open region above the transition. Larger lattices convert at lower~$f$. The dotted curve is the fraction of runs, pooled over all five sizes, in which a $100$-cell sell cluster was ever seen; such clusters appear even where nothing converts, so what moves with size is spreading rather than clustering. This is a descriptive threshold and not a certified critical nucleus. \textbf {(C)}~All $320$~conversion curves plotted against time rescaled by each run's own fitted rate constant, with $1 - \exp (-u^{n})$ overlaid at $n = 2.22$, the mean fitted exponent on the largest lattice. Sizes lie on top of one another; the band tightens with size, and $64 \times 64$, the smallest lattice fitted, visibly fails to collapse. The dispersion and timing of the conversion times themselves are given in Figure~\ref {fig:s7}}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Theory overview for Model~A (Rules~19280/19286). \textbf  {(A)}~Potts energy~$e$ and site entropy~$S_1$ vs.\ minority fraction~$f$ ($128 \times 128$ lattice, periodic boundaries, time-averaged over $2{,}000$ steps). The mixed attractor persists at $e \approx -0.37$ and $S_1 \approx 1.06$; above the transition the system collapses to the all-Sell state at $e \approx -0.93$ and $S_1 \approx 0.18$, a sharp finite-size drop ($\Delta e \approx 0.56$, $\Delta S_1 \approx 0.88$); near the crossover the $2{,}000$-step averages retain the mixed state because metastable lifetimes exceed the window, so the crossover completes to the right of the marked $f_c$. \textbf  {(B)}~Spectral radius of the pair-approximation Jacobian at the uncorrelated fixed point, declining monotonically from $0.95$ at $f = 0$ to $0.71$ at $f = 0.5$, strictly below the instability threshold (dashed line at~$1$). This tested pair closure does not capture the crossover. \textbf  {(C)}~Sell-cluster sizes in the mixed state (log scale): largest cluster ever observed (orange, dashed) and mean largest per snapshot (black), each the median over $20$ disorder seeds with an interquartile band, taken over $100$ snapshots of a $128 \times 128$ lattice. The mean largest cluster held at $31$~cells at $f = 0.05$ and $43$~cells at $f = 0.145$, while the largest observed cluster rose from $58$ to $98$~cells over the same range and to $253$~cells at $f = 0.16$. The band widens above the bracket, where seeds disagree: the middle half of them spanned $162$ to $379$~cells at $f = 0.16$. Dashed vertical lines mark the midpoint $f=0.145$ of the observed $[0.14,0.15]$ bracket.}}{21}{figure.caption.31}\protected@file@percent }
\newlabel{fig:theory}{{4}{21}{Theory overview for Model~A (Rules~19280/19286). \textbf {(A)}~Potts energy~$e$ and site entropy~$S_1$ vs.\ minority fraction~$f$ ($128 \times 128$ lattice, periodic boundaries, time-averaged over $2{,}000$ steps). The mixed attractor persists at $e \approx -0.37$ and $S_1 \approx 1.06$; above the transition the system collapses to the all-Sell state at $e \approx -0.93$ and $S_1 \approx 0.18$, a sharp finite-size drop ($\Delta e \approx 0.56$, $\Delta S_1 \approx 0.88$); near the crossover the $2{,}000$-step averages retain the mixed state because metastable lifetimes exceed the window, so the crossover completes to the right of the marked $f_c$. \textbf {(B)}~Spectral radius of the pair-approximation Jacobian at the uncorrelated fixed point, declining monotonically from $0.95$ at $f = 0$ to $0.71$ at $f = 0.5$, strictly below the instability threshold (dashed line at~$1$). This tested pair closure does not capture the crossover. \textbf {(C)}~Sell-cluster sizes in the mixed state (log scale): largest cluster ever observed (orange, dashed) and mean largest per snapshot (black), each the median over $20$ disorder seeds with an interquartile band, taken over $100$ snapshots of a $128 \times 128$ lattice. The mean largest cluster held at $31$~cells at $f = 0.05$ and $43$~cells at $f = 0.145$, while the largest observed cluster rose from $58$ to $98$~cells over the same range and to $253$~cells at $f = 0.16$. The band widens above the bracket, where seeds disagree: the middle half of them spanned $162$ to $379$~cells at $f = 0.16$. Dashed vertical lines mark the midpoint $f=0.145$ of the observed $[0.14,0.15]$ bracket}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The winning sell domain is a single dominant nucleus born in the bulk. \textbf  {(A)}~Four snapshots of the $64 \times 64$ grid in one collapse run ($f = 0.20$, cash $5{,}000$, seed~$20$), whose onset at $t = 328$ sits near the median of $374$~steps over the $19$ collapse runs that nucleated, with blue for Buy, gray for Hold, and orange for Sell. The cross marks the founding cell at its birth step $t = 203$, $15$~cells from the nearest frame, and the black outline traces that one cell's forward lineage: $75$~cells at $t = 265$, $208$~cells at onset, and $973$~cells by $t = 528$, grown without ever reaching the frame. \textbf  {(B)}~Map of the founding cell of the largest sell cluster at crash onset across the $39$ boundary-versus-bulk runs that nucleated, plotted on the interior alone so that a bulk birth can be told apart from attachment to the active-edge ring. \textbf  {(C)}~Distance of that founding cell from the nearest boundary, pooled over the $20$ freeze and $19$ collapse runs, against the uniform-null expectation and with the boundary shell ($d \le 2$) shaded. Births were bulk-dominated and consistent with a uniform distribution: the pooled fraction founded within distance~$2$ of the boundary was $0.077$, below rather than above the $0.125$ uniform null and statistically indistinguishable from it (binomial $p = 0.47$), with a median founding distance of $12$ cells into the deep bulk. Per-seed ratios of the largest cluster to the total sell population at its peak, and the growth trajectories behind them, are given in Figure~\ref {fig:s2}.}}{22}{figure.caption.32}\protected@file@percent }
\newlabel{fig:nucleus}{{5}{22}{The winning sell domain is a single dominant nucleus born in the bulk. \textbf {(A)}~Four snapshots of the $64 \times 64$ grid in one collapse run ($f = 0.20$, cash $5{,}000$, seed~$20$), whose onset at $t = 328$ sits near the median of $374$~steps over the $19$ collapse runs that nucleated, with blue for Buy, gray for Hold, and orange for Sell. The cross marks the founding cell at its birth step $t = 203$, $15$~cells from the nearest frame, and the black outline traces that one cell's forward lineage: $75$~cells at $t = 265$, $208$~cells at onset, and $973$~cells by $t = 528$, grown without ever reaching the frame. \textbf {(B)}~Map of the founding cell of the largest sell cluster at crash onset across the $39$ boundary-versus-bulk runs that nucleated, plotted on the interior alone so that a bulk birth can be told apart from attachment to the active-edge ring. \textbf {(C)}~Distance of that founding cell from the nearest boundary, pooled over the $20$ freeze and $19$ collapse runs, against the uniform-null expectation and with the boundary shell ($d \le 2$) shaded. Births were bulk-dominated and consistent with a uniform distribution: the pooled fraction founded within distance~$2$ of the boundary was $0.077$, below rather than above the $0.125$ uniform null and statistically indistinguishable from it (binomial $p = 0.47$), with a median founding distance of $12$ cells into the deep bulk. Per-seed ratios of the largest cluster to the total sell population at its peak, and the growth trajectories behind them, are given in Figure~\ref {fig:s2}}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Budgets gate the growth of the nucleus rather than its birth. \textbf  {(A)}~Four snapshots of the $64 \times 64$ grid under a tight budget (cash $500$, top row) and a loose one (cash $5{,}000$, bottom row) at $f = 0.20$, both from seed~$17$, with blue for Buy, gray for Hold, and orange for Sell. Each row is cut at its own onset step, $t_{\mathrm  {on}} = 350$ above and $374$ below, and then at $100$, $250$, and $400$~steps after it, so the two arms are compared on their own clocks rather than on one shared one. The black outline traces the largest sell cluster in each frame. Both arms enter the first tile just past the $205$-cell onset threshold, at $210$ and $225$~cells, and by $400$~steps the loose budget's domain has reached $873$~cells against the tight budget's $516$. \textbf  {(B)}~Kaplan--Meier median onset times (points) against the minority fraction~$f$ at cash $500$, $1{,}000$, and $5{,}000$, each with its fitted divergence $\ln \tilde  \tau = A + B/(f - f_0)$ (solid curves) and the Model~A fit of Equation~\eqref  {eq:kramers} dashed for reference; the fitted curves are drawn only up to a display ceiling so that the medians are not crushed by the divergence near $f_0$. Censoring at the horizon and its handling in the medians are detailed in Appendix~\ref {app:censoring}, and the fitted parameters with their bootstrap intervals in Figure~\ref {fig:s4}. \textbf  {(C)}~Front velocity against absolute budget suppression at $f = 0.20$ for the $97$ runs included across the five cash doses ($250$--$5{,}000$; $3$ runs excluded by the window rule). The velocity is the OLS slope of the front extent over the onset-aligned window $[t_{\mathrm  {on}}+50,\,t_{\mathrm  {on}}+400]$ and the suppression is the mean absolute number of suppressed buy orders per step over the same window, colored by dose with the per-dose medians marked as diamonds; velocity fell as suppression rose, Spearman $\rho = -0.372$, permutation $p = 0.0003$. The same velocities arranged by initial cash are given in Figure~\ref {fig:s4}, where the per-dose medians are U-shaped rather than monotone. The stamped-patch design behind the $0/20$ dominance rate is given in Figure~\ref {fig:s5}.}}{23}{figure.caption.33}\protected@file@percent }
\newlabel{fig:growth-gating}{{6}{23}{Budgets gate the growth of the nucleus rather than its birth. \textbf {(A)}~Four snapshots of the $64 \times 64$ grid under a tight budget (cash $500$, top row) and a loose one (cash $5{,}000$, bottom row) at $f = 0.20$, both from seed~$17$, with blue for Buy, gray for Hold, and orange for Sell. Each row is cut at its own onset step, $t_{\mathrm {on}} = 350$ above and $374$ below, and then at $100$, $250$, and $400$~steps after it, so the two arms are compared on their own clocks rather than on one shared one. The black outline traces the largest sell cluster in each frame. Both arms enter the first tile just past the $205$-cell onset threshold, at $210$ and $225$~cells, and by $400$~steps the loose budget's domain has reached $873$~cells against the tight budget's $516$. \textbf {(B)}~Kaplan--Meier median onset times (points) against the minority fraction~$f$ at cash $500$, $1{,}000$, and $5{,}000$, each with its fitted divergence $\ln \tilde \tau = A + B/(f - f_0)$ (solid curves) and the Model~A fit of Equation~\eqref {eq:kramers} dashed for reference; the fitted curves are drawn only up to a display ceiling so that the medians are not crushed by the divergence near $f_0$. Censoring at the horizon and its handling in the medians are detailed in Appendix~\ref {app:censoring}, and the fitted parameters with their bootstrap intervals in Figure~\ref {fig:s4}. \textbf {(C)}~Front velocity against absolute budget suppression at $f = 0.20$ for the $97$ runs included across the five cash doses ($250$--$5{,}000$; $3$ runs excluded by the window rule). The velocity is the OLS slope of the front extent over the onset-aligned window $[t_{\mathrm {on}}+50,\,t_{\mathrm {on}}+400]$ and the suppression is the mean absolute number of suppressed buy orders per step over the same window, colored by dose with the per-dose medians marked as diamonds; velocity fell as suppression rose, Spearman $\rho = -0.372$, permutation $p = 0.0003$. The same velocities arranged by initial cash are given in Figure~\ref {fig:s4}, where the per-dose medians are U-shaped rather than monotone. The stamped-patch design behind the $0/20$ dominance rate is given in Figure~\ref {fig:s5}}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Liquidity intervention is asymmetric. Paired, onset-aligned counterfactuals at $f = 0.20$ with a $W = 400$ post-toggle window and $19$ included seed pairs per arm; the pre-toggle trajectories coincide by construction. \textbf  {(A)}~Four snapshots of the $64 \times 64$ grid in one injection pair, control above and cash $\times 10$ below (seed~$16$, $t_{\mathrm  {on}} = 268$, the pair whose velocity gain sits at the median of the $14$ that accelerated), with blue for Buy, gray for Hold, and orange for Sell. The first column is one step before the toggle, where the two rows are identical cell for cell, and the remaining three are $100$, $250$, and $400$~steps after it. The black outline traces the largest sell cluster in each frame: the shared $190$-cell domain grew to $198$~cells under injection while the control's broke up to $38$. \textbf  {(B)}~Edge-ring Buy and Sell fractions under injection, averaged over the $19$ seed pairs and aligned at the per-seed onset, for the toggled arm against its control, with the dashed line marking the toggle at $t_{\mathrm  {on}}$. Injection flipped the ring at the toggle, from the control's ${\sim }0.5$ Buy and $0$ Sell to $0$ Buy and ${\sim }1.0$ Sell, and the flipped state decayed back over the following $100$--$200$ steps as the EMA bands caught up with the supported price. \textbf  {(C)}~Front velocity over the window for every seed pair, one control-to-toggled segment per pair, with injection at left in orange and the mild ($\times 0.1$) and harsh ($\times 0.01$) withdrawals beside it in gray, the harsh dose the paler of the two; injection sits on the tight cash-$500$ base and both withdrawals on the loose cash-$5{,}000$ base. Each arm carries its control and toggled medians as text above it, in that order. Injection accelerated the front in $14$ of $19$ pairs (sign test $p = 0.064$), while withdrawal was null at both doses (sign-flip permutation $p = 0.67$ mild, $p = 0.29$ harsh). The mild arm's two medians rise even so, $2.23$ to $3.57$, although only $8$ of its $19$ pairs individually rose, so its marginal medians and the paired difference the test uses disagree in sign. The cluster trajectories and the withdrawal ring traces for all three arms are given in Figure~\ref {fig:s6}.}}{24}{figure.caption.34}\protected@file@percent }
\newlabel{fig:intervention}{{7}{24}{Liquidity intervention is asymmetric. Paired, onset-aligned counterfactuals at $f = 0.20$ with a $W = 400$ post-toggle window and $19$ included seed pairs per arm; the pre-toggle trajectories coincide by construction. \textbf {(A)}~Four snapshots of the $64 \times 64$ grid in one injection pair, control above and cash $\times 10$ below (seed~$16$, $t_{\mathrm {on}} = 268$, the pair whose velocity gain sits at the median of the $14$ that accelerated), with blue for Buy, gray for Hold, and orange for Sell. The first column is one step before the toggle, where the two rows are identical cell for cell, and the remaining three are $100$, $250$, and $400$~steps after it. The black outline traces the largest sell cluster in each frame: the shared $190$-cell domain grew to $198$~cells under injection while the control's broke up to $38$. \textbf {(B)}~Edge-ring Buy and Sell fractions under injection, averaged over the $19$ seed pairs and aligned at the per-seed onset, for the toggled arm against its control, with the dashed line marking the toggle at $t_{\mathrm {on}}$. Injection flipped the ring at the toggle, from the control's ${\sim }0.5$ Buy and $0$ Sell to $0$ Buy and ${\sim }1.0$ Sell, and the flipped state decayed back over the following $100$--$200$ steps as the EMA bands caught up with the supported price. \textbf {(C)}~Front velocity over the window for every seed pair, one control-to-toggled segment per pair, with injection at left in orange and the mild ($\times 0.1$) and harsh ($\times 0.01$) withdrawals beside it in gray, the harsh dose the paler of the two; injection sits on the tight cash-$500$ base and both withdrawals on the loose cash-$5{,}000$ base. Each arm carries its control and toggled medians as text above it, in that order. Injection accelerated the front in $14$ of $19$ pairs (sign test $p = 0.064$), while withdrawal was null at both doses (sign-flip permutation $p = 0.67$ mild, $p = 0.29$ harsh). The mild arm's two medians rise even so, $2.23$ to $3.57$, although only $8$ of its $19$ pairs individually rose, so its marginal medians and the paired difference the test uses disagree in sign. The cluster trajectories and the withdrawal ring traces for all three arms are given in Figure~\ref {fig:s6}}{figure.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Wolfram totalistic CA rule taxonomy. Base-3 encoding reads right-to-left: digit $a_i$ gives the next state when the neighborhood sum index equals $i$.}}{25}{table.caption.35}\protected@file@percent }
\newlabel{tab:rule-taxonomy}{{1}{25}{Wolfram totalistic CA rule taxonomy. Base-3 encoding reads right-to-left: digit $a_i$ gives the next state when the neighborhood sum index equals $i$}{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Empirical fits $\ln \tilde  \tau = A + B/(f - f_0)$ to Kaplan--Meier median onset times, per cash level, with the Model~A fit for reference. The Model~A row is the mean-lifetime fit of Equation~\eqref  {eq:kramers}; the Model~B rows fit Kaplan--Meier medians. Brackets are 95\% bootstrap CIs (2{,}000 resamples of seeds within each~$f$). The cash-500 $f_0$ lower bound of $0.000$ is the physical boundary of the fit domain, not a data quantile. CIs overlap between tight (500) and loose (5000) cash on both $B$ and $f_0$, but this overlap does not establish parameter equality.}}{26}{table.caption.36}\protected@file@percent }
\newlabel{tab:kramers-fits}{{2}{26}{Empirical fits $\ln \tilde \tau = A + B/(f - f_0)$ to Kaplan--Meier median onset times, per cash level, with the Model~A fit for reference. The Model~A row is the mean-lifetime fit of Equation~\eqref {eq:kramers}; the Model~B rows fit Kaplan--Meier medians. Brackets are 95\% bootstrap CIs (2{,}000 resamples of seeds within each~$f$). The cash-500 $f_0$ lower bound of $0.000$ is the physical boundary of the fit domain, not a data quantile. CIs overlap between tight (500) and loose (5000) cash on both $B$ and $f_0$, but this overlap does not establish parameter equality}{table.caption.36}{}}
