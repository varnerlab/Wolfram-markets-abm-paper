\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Spatiotemporal dynamics of the $256 \times 256$ agent grid under Model~A (Rules~19280/19286, QQQ 2024 data). Columns share logarithmically spaced time points; rows vary the minority fraction~$f$. Blue = Buy, gray = Hold, orange = Sell. At $f = 0.15$ (middle row, $t = 8{,}236$), a sell cascade nucleates from a localized seed and propagates as a coherent wavefront before engulfing the grid.}}{8}{figure.caption.27}\protected@file@percent }
\newlabel{fig:fig2}{{2}{8}{Spatiotemporal dynamics of the $256 \times 256$ agent grid under Model~A (Rules~19280/19286, QQQ 2024 data). Columns share logarithmically spaced time points; rows vary the minority fraction~$f$. Blue = Buy, gray = Hold, orange = Sell. At $f = 0.15$ (middle row, $t = 8{,}236$), a sell cascade nucleates from a localized seed and propagates as a coherent wavefront before engulfing the grid}{figure.caption.27}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Mean-Field Analysis}{8}{subsection.30}\protected@file@percent }
