\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Phase diagram for Model~A (Rules~19280/19286, $128 \times 128$ grid). \textbf  {A:}~Mean sell fraction vs.\ minority fraction~$f$. \textbf  {B:}~Peak sell fraction. \textbf  {C:}~Crash frequency (fraction of time steps with sell fraction $> 0.50$). Dashed vertical line marks $f_c \approx 0.145$. The transition is discontinuous, consistent with a first-order phase transition.}}{8}{figure.caption.29}\protected@file@percent }
\newlabel{fig:fig3}{{3}{8}{Phase diagram for Model~A (Rules~19280/19286, $128 \times 128$ grid). \textbf {A:}~Mean sell fraction vs.\ minority fraction~$f$. \textbf {B:}~Peak sell fraction. \textbf {C:}~Crash frequency (fraction of time steps with sell fraction $> 0.50$). Dashed vertical line marks $f_c \approx 0.145$. The transition is discontinuous, consistent with a first-order phase transition}{figure.caption.29}{}}
